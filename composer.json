
{
    "name": "your-name/laravel-say-logger",
    "description": "A Laravel package for logging with macOS say command",
    "type": "library",
    "require": {
        "php": "^7.4|^8.0",
        "illuminate/support": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "YourName\\LaravelSayLogger\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "YourName\\LaravelSayLogger\\LaravelSayLoggerServiceProvider"
            ]
        }
    }
}
